# AURELIS backend — environment template.
# Copy to `.env` and adjust. Never commit the real `.env`.

# ── Application ───────────────────────────────────────────────────────
APP_NAME="AURELIS Intelligence API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:12000,http://127.0.0.1:12000,https://work-1-ooybdhcqzzriumsx.prod-runtime.all-hands.dev

# ── Server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=12001

# ── Database ──────────────────────────────────────────────────────────
# SQLAlchemy URL — the path the API serves traffic from. SQLite is the
# zero-dependency default; PostgreSQL is the production target (see README).
# For a Supabase project use the connection string from
# Dashboard → Project Settings → Database → Connection string (URI):
#   postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./aurelis.db

# ── Supabase (MODULE 3) ───────────────────────────────────────────────
# Used by the REST/Realtime seam and by GET /health/ready. SQLAlchemy keeps
# using DATABASE_URL above, so the app runs fine with these left blank.
# Dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY. The service-role key bypasses Row Level Security. Never put it
# in a VITE_ variable or any client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ── Model layer ───────────────────────────────────────────────────────
# The engine seam. `simulator` is the deterministic local response engine;
# MODULE 6 swaps this to `openai` and fills AI_PROVIDER_API_KEY / AI_MODEL.
AI_PROVIDER=simulator
AI_MODEL=
AI_PROVIDER_API_KEY=

# ── Authentication (MODULE 4) ─────────────────────────────────────────
# HMAC key that signs access tokens. REQUIRED outside development/test: the
# app refuses to boot with the built-in development default. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
RESET_TOKEN_EXPIRE_MINUTES=30

# Argon2id work factor. Stored hashes embed their parameters, so raising these
# later does not invalidate existing passwords.
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_PARALLELISM=4

# ── Session cookies ───────────────────────────────────────────────────
# Both tokens travel in HttpOnly cookies; `aurelis_csrf` is deliberately
# readable by JS so the SPA can echo it in the X-CSRF-Token header.
# A cross-site frontend needs COOKIE_SAMESITE=none, which browsers only honour
# together with COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
# Leave blank to derive from APP_ENV (secure outside development/test).
COOKIE_SECURE=
COOKIE_DOMAIN=

# ── Abuse controls ────────────────────────────────────────────────────
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_MAX_FAILED_LOGINS=10
AUTH_LOCKOUT_SECONDS=900

# ── Administrator provisioning ────────────────────────────────────────
# Read only by `python -m app.cli.create_admin`. Never seeded or committed;
# public registration always creates a normal user.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=AURELIS Administrator
