# AURELIS backend — environment template.
# Copy to `.env` and adjust. Never commit the real `.env`.

# ── Application ───────────────────────────────────────────────────────
APP_NAME="AURELIS Intelligence API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:12000,http://127.0.0.1:12000,https://work-1-ooybdhcqzzriumsx.prod-runtime.all-hands.dev

# ── Server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=12001

# ── Database ──────────────────────────────────────────────────────────
# SQLAlchemy URL. SQLite is the zero-dependency default; PostgreSQL is the
# production target (see README). Example Postgres URL:
#   postgresql+psycopg://aurelis:secret@localhost:5432/aurelis
DATABASE_URL=sqlite:///./aurelis.db

# ── Model layer ───────────────────────────────────────────────────────
# The engine seam. `simulator` is the deterministic local response engine;
# MODULE 6 swaps this to `openai` and fills AI_PROVIDER_API_KEY / AI_MODEL.
AI_PROVIDER=simulator
AI_MODEL=
AI_PROVIDER_API_KEY=
