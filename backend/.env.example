# AURELIS backend — environment template.
# Copy to `.env` and adjust. Never commit the real `.env`.

# ── Application ───────────────────────────────────────────────────────
APP_NAME="AURELIS Intelligence API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:12000,http://127.0.0.1:12000,https://work-1-ooybdhcqzzriumsx.prod-runtime.all-hands.dev

# ── Server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=12001

# ── Database ──────────────────────────────────────────────────────────
# SQLAlchemy URL — the path the API serves traffic from. SQLite is the
# zero-dependency default; PostgreSQL is the production target (see README).
# For a Supabase project use the connection string from
# Dashboard → Project Settings → Database → Connection string (URI):
#   postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./aurelis.db

# ── Supabase (MODULE 3) ───────────────────────────────────────────────
# Used by the REST/Realtime seam and by GET /health/ready. SQLAlchemy keeps
# using DATABASE_URL above, so the app runs fine with these left blank.
# Dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY. The service-role key bypasses Row Level Security. Never put it
# in a VITE_ variable or any client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ── Model layer (STEP 6) ──────────────────────────────────────────────
# `simulator` is the deterministic offline engine (tests + local dev, no
# credentials). Set AI_PROVIDER=openai for a real provider — the key lives only
# here, server-side, and is never sent to the browser or a VITE_ variable.
AI_PROVIDER=simulator
AI_MODEL=
AI_PROVIDER_API_KEY=
# Override for an OpenAI-compatible gateway (Azure, vLLM, OpenRouter…). Leave
# blank for the provider's official endpoint.
AI_BASE_URL=
AI_DEFAULT_MODEL=
# Comma-separated allow-list. Blank ⇒ only the resolved default is accepted.
AI_ALLOWED_MODELS=
# Every provider call is bounded; nothing may hang forever.
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_INPUT_TOKENS=8192
AI_TEMPERATURE=0.7
AI_TOP_P=1.0
AI_STREAMING_ENABLED=true
# Context window: how many prior messages may be replayed to the model.
AI_MAX_CONTEXT_MESSAGES=20
# Retries apply only to transient failures, with exponential backoff + jitter.
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5
# Optional server-side override of the built-in system prompt.
AI_SYSTEM_PROMPT=
# Title generation is a side task with its own (small) budget.
AI_TITLE_GENERATION_ENABLED=true
AI_TITLE_MAX_TOKENS=24
# Cost foundation. Leave at zero unless the deployment knows its real pricing —
# a zero price records no cost rather than inventing one.
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
AI_COST_CURRENCY=USD
AI_PRICING_VERSION=

# ── Authentication (MODULE 4) ─────────────────────────────────────────
# HMAC key that signs access tokens. REQUIRED outside development/test: the
# app refuses to boot with the built-in development default. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
RESET_TOKEN_EXPIRE_MINUTES=30

# Argon2id work factor. Stored hashes embed their parameters, so raising these
# later does not invalidate existing passwords.
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_PARALLELISM=4

# ── Session cookies ───────────────────────────────────────────────────
# Both tokens travel in HttpOnly cookies; `aurelis_csrf` is deliberately
# readable by JS so the SPA can echo it in the X-CSRF-Token header.
# A cross-site frontend needs COOKIE_SAMESITE=none, which browsers only honour
# together with COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
# Leave blank to derive from APP_ENV (secure outside development/test).
COOKIE_SECURE=
COOKIE_DOMAIN=

# ── Abuse controls ────────────────────────────────────────────────────
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_MAX_FAILED_LOGINS=10
AUTH_LOCKOUT_SECONDS=900

# Optional shared rate-limit store. With it set, counters live in Redis so all
# workers share one budget (install the `redis` package to enable it). Without
# it the in-process limiter is used — fine for one worker, per-worker budgets
# for several. Use rediss:// (TLS) outside development.
REDIS_URL=

# ── Request handling ──────────────────────────────────────────────────
# Maximum JSON request body size in bytes (default 1 MiB).
MAX_REQUEST_BODY_BYTES=1048576
# Serve Swagger/ReDoc/OpenAPI? Unset ⇒ on in development, off outside it.
ENABLE_API_DOCS=
# HSTS lifetime in seconds; only sent over HTTPS.
HSTS_MAX_AGE_SECONDS=31536000

# ── File uploads (Step 8 foundation) ──────────────────────────────────
# Leave empty to disable uploads. When set, files are written here and the
# upload validator (app/core/uploads.py) enforces size/MIME/extension and
# generates the stored filename — user input never becomes a path segment.
UPLOAD_STORAGE_DIR=
MAX_UPLOAD_BYTES=10485760

# ── Administrator provisioning ────────────────────────────────────────
# Read only by `python -m app.cli.create_admin`. Never seeded or committed;
# public registration always creates a normal user.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=AURELIS Administrator
